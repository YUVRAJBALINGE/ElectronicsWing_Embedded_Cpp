#include "iostream.h"
#include "conio.h"
//function overloading

class item{
 private:
 int x;
 int y;

 public:
 void sum()
 {
 x=2;
 y=3;
 }
 void sum(int p)
 {
 x=p;
 y=p;
 }
 void sum(int a,int b){
 x=a;
 y=b;
 }

 void display(){
 cout<<x<<y;
 }


};


void main()
{
clrscr();
item t;
t.sum(5,6);
t.display();

getch();
}
