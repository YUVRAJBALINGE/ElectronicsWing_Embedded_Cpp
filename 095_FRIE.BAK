void calMean(item p)
{
float sum;
sum = (p.x+p.y)/2.0;
cout << "Mean="<<sum;
}

void calMean1(item a, item1 b){
float sum;
sum = (a.x + a.y + b.x + b.y)/4;
cout << "Mean=" <<sum;
}

