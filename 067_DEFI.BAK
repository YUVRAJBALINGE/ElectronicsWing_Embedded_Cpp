//Write the c++ function program to find sum of 2 digit input x,y

#include<iostream.h>
#include<conio.h>


class math_operation{

	private:
	int x, y;
	int result;

	public:
	void dataSum();
	void getdata();
	void displayResult();

};

void math_operation::getdata(){

cout<<"Input Values of x & y=";
cin>>x>>y;

}
void math_operation::dataSum(){
  result = x	+	y;
}

void math_operation::displayResult(){
cout << "\nResult="<<result;
}

int main(){

	clrscr();

	math_operation t;
	t.getdata();
	t.dataSum();
	t.displayResult();

	getch();

	return 0;
}