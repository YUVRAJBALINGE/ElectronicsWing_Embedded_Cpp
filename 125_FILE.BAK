/*
@brief : Write down the code in c++ to merge data of file1 to file2

@param :  file1. txt & file2.txt
@ reval : Successfully merge the content of file1 to file 2
*/

#include "iostream.h"
#include "conio.h"
#include "fstream.h"

void main(){
clrscr();
ifstream fin;
ofstream fout;

fin.open("file1.txt",ios::in);
fout.open("file2.txt",ios::app);
char x;

while(!fin.eof())
{
x = fin.get();
fout.put(x);

}


cout << "Data of file merged from file 1 to file2";
getch();
}