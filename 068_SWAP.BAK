//Write C++ program to input the swaping of x & y using class & object

#include<iostream.h>
#include<conio.h>


class swap{
private:
int x,y;

public:
void getData();
void swap_algorithm1();
void display();
};

void swap::getData(){
cout<<"\nEnter the value x & y=";
cin>>x>>y;
}
void swap::display()
{
cout<<"\nx="<<x<<"y="<<y ;
}
void swap::swap_algorithm1(){
int t;
t=x;
x=y;
y=t;
}

void main(){
	     clrscr();

	     swap t;
	     t.getData();
	     t.swap_algorithm1();
	     t.display();

	     getch();
}

